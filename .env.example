# Copy to .env and fill in values:
#   cp .env.example .env

# Required only if you use "Explain with AI"
GROQ_API_KEY=your_groq_api_key_here

# Optional: set to production on the server
# FLASK_ENV=production

# Optional: change if 8000 is in use (e.g. Cloudflare Tunnel → http://127.0.0.1:8003)
# GUNICORN_BIND=127.0.0.1:8003
